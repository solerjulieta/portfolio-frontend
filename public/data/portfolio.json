                                    "hsl": "210°, 100%, 20%"
                                },
                                {
                                    "name": { "es": "Blue Violet", "en": "Blue Violet" },
                                    "hex": "#6633FF",
                                    "rgb": "102, 51, 255",
                                    "hsl": "255°, 100%, 60%"
                                },
                                {
                                    "name": { "es": "Amethyst Purple", "en": "Amethyst Purple" },
                                    "hex": "#9933CC",
                                    "rgb": "153, 51, 204",
                                    "hsl": "280°, 60%, 50%"
                                }
                            ]
                        },
                        "principles": {
                            "label": { "es": "Principios del color", "en": "Principles color" },
                            "items": [
                                {
                                    "icon": "shield-check",
                                    "title": { "es": "Seguridad", "en": "Security" },
                                    "description": { "es": "El uso del color refuerza la claridad y la transparencia, comunicando que cada interacción se da dentro de un entorno verificado y confiable.", "en": "The use of color reinforces clarity and transparency, communicating that every interaction takes place within a verified and trustworthy environment." }
                                },
                                {
                                    "icon": "eye",
                                    "title": { "es": "Confianza", "en": "Trust" },
                                    "description": { "es": "La consistencia cromática construye una identidad reconocible que acompaña al usuario y fortalece la confianza en cada decisión.", "en": "Chromatic consistency builds a recognizable identity that supports users and strengthens trust in every decision." }
                                },
                                {
                                    "icon": "users",
                                    "title": { "es": "Inclusión", "en": "Inclusion" },
                                    "description": { "es": "El sistema visual se diseña para ser accesible y empático, promoviendo una experiencia clara, legible y abierta a todas las personas.", "en": "The visual system is designed to be accessible and empathetic, promoting a clear, legible, and open experience for everyone." }
                                }
                            ]
                        }
                    },
                    {
                        "order": 4,
                        "key": "typo",
                        "subtitle": { "es": "Tipografía", "en": "Typography" },
                        "title": { "es": "Donde nace la voz de la marca", "en": "Where the brand’s voice begins" },
                        "body": { "es": "La tipografía es una extensión de la personalidad de la marca. A través de sus formas y ritmos construye una voz visual clara y cercana, que guía la lectura y refuerza la confianza en cada interacción. Sus trazos transmiten **legibilidad, amistad, flexibilidad y modernidad**, asegurando una experiencia coherente y accesible en todos los puntos de contacto.", "en": "Typography is an extension of the brand’s personality. Through its shapes and rhythms, it builds a clear and approachable visual voice that guides reading and reinforces trust in every interaction. Its strokes convey **legibility, friendliness, flexibility, and modernity**, ensuring a coherent and accessible experience across all touchpoints." },
                        "typography": {
                            "fontName": "Dosis",
                            "samples": [
                                {
                                    "weight": "regular",
                                    "label": { "es": "Regular", "en": "Regular" },
